<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_PUNGAMAIL_SIGNUP</name>
	<version>0.4.5</version>
	<creationDate>2026-09-04</creationDate>
	<author>Punga</author>
	<license>MIT License</license>
	<description>MOD_PUNGAMAIL_SIGNUP_DESCRIPTION</description>
	<namespace path="src">Punga\Module\PungaMailSignup</namespace>
	<files>
		<folder module="mod_pungamail_signup">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="intro" type="textarea" label="MOD_PUNGAMAIL_SIGNUP_INTRO" description="MOD_PUNGAMAIL_SIGNUP_INTRO_DESC" />
				<field name="button_label" type="text" label="MOD_PUNGAMAIL_SIGNUP_BUTTON_LABEL" description="MOD_PUNGAMAIL_SIGNUP_BUTTON_LABEL_DESC" />
				<field name="topic_ids" type="sql" multiple="true" layout="joomla.form.field.list-fancy-select" query="SELECT id AS value, title AS text FROM #__pungamail_topics WHERE state = 1 ORDER BY ordering, title" key_field="value" value_field="text" label="MOD_PUNGAMAIL_SIGNUP_TOPICS" description="MOD_PUNGAMAIL_SIGNUP_TOPICS_DESC" />
			</fieldset>
		</fields>
	</config>
</extension>
