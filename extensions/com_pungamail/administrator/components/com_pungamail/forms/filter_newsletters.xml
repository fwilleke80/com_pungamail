<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="COM_PUNGAMAIL_FILTER_SEARCH" hint="JSEARCH_FILTER" />
		<field name="state" type="list" label="JSTATUS" onchange="this.form.submit();">
			<option value="">COM_PUNGAMAIL_FILTER_STATE_CURRENT</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="status" type="list" label="COM_PUNGAMAIL_DELIVERY_STATUS" onchange="this.form.submit();">
			<option value="">COM_PUNGAMAIL_FILTER_DELIVERY_STATUS</option>
			<option value="0">COM_PUNGAMAIL_STATUS_DRAFT</option>
			<option value="1">COM_PUNGAMAIL_STATUS_QUEUED</option>
			<option value="2">COM_PUNGAMAIL_STATUS_SENDING</option>
			<option value="3">COM_PUNGAMAIL_STATUS_SENT</option>
			<option value="4">COM_PUNGAMAIL_STATUS_SENT_WITH_FAILURES</option>
			<option value="5">COM_PUNGAMAIL_STATUS_SCHEDULED</option>
			<option value="6">COM_PUNGAMAIL_STATUS_FAILED</option>
			<option value="7">COM_PUNGAMAIL_STATUS_CANCELLED</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.created DESC" onchange="this.form.submit();">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.subject ASC">COM_PUNGAMAIL_SUBJECT_ASC</option>
			<option value="a.subject DESC">COM_PUNGAMAIL_SUBJECT_DESC</option>
			<option value="a.status ASC">COM_PUNGAMAIL_DELIVERY_STATUS_ASC</option>
			<option value="a.status DESC">COM_PUNGAMAIL_DELIVERY_STATUS_DESC</option>
			<option value="a.recipient_count ASC">COM_PUNGAMAIL_RECIPIENTS_ASC</option>
			<option value="a.recipient_count DESC">COM_PUNGAMAIL_RECIPIENTS_DESC</option>
			<option value="a.sent_count ASC">COM_PUNGAMAIL_SENT_ASC</option>
			<option value="a.sent_count DESC">COM_PUNGAMAIL_SENT_DESC</option>
			<option value="a.failed_count ASC">COM_PUNGAMAIL_FAILED_ASC</option>
			<option value="a.failed_count DESC">COM_PUNGAMAIL_FAILED_DESC</option>
			<option value="a.sent_at ASC">COM_PUNGAMAIL_SENT_AT_ASC</option>
			<option value="a.sent_at DESC">COM_PUNGAMAIL_SENT_AT_DESC</option>
			<option value="a.scheduled_at ASC">COM_PUNGAMAIL_SCHEDULED_AT_ASC</option>
			<option value="a.scheduled_at DESC">COM_PUNGAMAIL_SCHEDULED_AT_DESC</option>
			<option value="a.created ASC">JDATE_ASC</option>
			<option value="a.created DESC">JDATE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
	</fields>
</form>
