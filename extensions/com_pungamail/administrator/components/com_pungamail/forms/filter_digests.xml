<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="COM_PUNGAMAIL_FILTER_SEARCH" hint="JSEARCH_FILTER" />
		<field name="state" type="list" label="JSTATUS" onchange="this.form.submit();"><option value="">COM_PUNGAMAIL_FILTER_STATE_ACTIVE</option><option value="1">JENABLED</option><option value="0">JDISABLED</option><option value="-2">JTRASHED</option></field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.next_run_at ASC" onchange="this.form.submit();"><option value="">JGLOBAL_SORT_BY</option><option value="a.title ASC">JGLOBAL_TITLE_ASC</option><option value="a.title DESC">JGLOBAL_TITLE_DESC</option><option value="a.next_run_at ASC">JDATE_ASC</option><option value="a.next_run_at DESC">JDATE_DESC</option><option value="a.id ASC">JGRID_HEADING_ID_ASC</option><option value="a.id DESC">JGRID_HEADING_ID_DESC</option></field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
	</fields>
</form>
